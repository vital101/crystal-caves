# Build context for the production image (root Dockerfile: wasm build + nginx).
# The dev toolchain image is built from docker/Dockerfile.dev, which uses its
# own sibling ignore file (docker/Dockerfile.dev.dockerignore) and needs the
# tools/ and notes/ trees excluded here.
#
# Only what the image build needs: wasm/ sources and out/portable/ assets.
.git
.github
.venv

# Original EXE/archive material and research notes are not part of the image.
extracted
notes
tools

# Keep the portable asset trees; drop the reference renders and scratch output.
out/*
!out/portable
!out/portable_ep2
!out/portable_ep3

# Locally built/generated outputs are rebuilt inside the image.
wasm/node_modules
wasm/assets
wasm/assets_ep2
wasm/assets_ep3
wasm/render.wasm
wasm/app.js
wasm/app.wasm
wasm/out_wasm_level*.png
wasm/oracle_level*.json

# Docs and OS noise.
**/*.md
**/.DS_Store
